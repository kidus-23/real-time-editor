# V3/editor — environment variables
#
# Copy the relevant values into Vercel (Project Settings → Environment Variables)
# and into a local `.env.local` for development. This file is documentation only.

# ── Clerk (required — app will not render without it) ──────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# ── Liveblocks (required — realtime collab) ────────────────────────
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_...
LIVEBLOCKS_PRIVATE_KEY=sk_...

# ── Firebase Admin (required by server actions) ────────────────────
# Contents of the service-account JSON (single line, JSON.stringify'd)
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── PostHog (analytics + error tracking) ───────────────────────────
# Project API Key from PostHog → Project Settings.
# The app runs fine without it: PostHog simply stays disabled.
NEXT_PUBLIC_POSTHOG_KEY=
# Only needed if your project is NOT in the US region (eu: https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── AI features (used by /api/chat, /api/compose, /api/generate-tags) ─
# NOTE: the code reads GOOGLE_AI_API_KEY (not GOOGLE_API_KEY).
# These are fallbacks only — users can supply their own keys (BYOK) in Settings.
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# ── Misc ───────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=
