# V3/editor — environment variables
#
# Copy the relevant values into Vercel (Project Settings → Environment Variables)
# and into a local `.env.local` for development. This file is documentation only.

# ── Clerk (required — app will not render without it) ──────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...

# ── Firebase Admin (required by server actions) ────────────────────
# Contents of the service-account JSON, or the path to service_key.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── PostHog (analytics + error tracking) ───────────────────────────
# Create a project at https://posthog.com → Project Settings → Project API Key.
# The app runs fine without it: PostHog simply stays disabled.
NEXT_PUBLIC_POSTHOG_KEY=
# Only needed if your project is NOT in the US region (eu: https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── AI features (used by /api/generate-tags, /api/compose, /api/chat) ─
GOOGLE_API_KEY=
