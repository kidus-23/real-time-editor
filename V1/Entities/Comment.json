{
  "name": "Comment",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "ID of the document this comment belongs to"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "description": "Position coordinates for the comment"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "Whether the comment is resolved"
    },
    "parent_id": {
      "type": "string",
      "description": "ID of parent comment for threading"
    },
    "mentioned_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses of mentioned users"
    }
  },
  "required": [
    "document_id",
    "content"
  ]
}