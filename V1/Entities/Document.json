{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "content": {
      "type": "string",
      "description": "Rich text content of the document"
    },
    "type": {
      "type": "string",
      "enum": [
        "document",
        "code",
        "research",
        "whiteboard"
      ],
      "default": "document",
      "description": "Type of document"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether document is public or private"
    },
    "collaborators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses of collaborators"
    },
    "last_edited_by": {
      "type": "string",
      "description": "Email of last editor"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Document version number"
    }
  },
  "required": [
    "title",
    "content"
  ]
}